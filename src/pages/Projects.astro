---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Cards/Projects/Card.astro";
import { getCollection } from "astro:content";


const allprojects = await getCollection("projects");
---

<Layout title="JeanDev | Projects">
<div class="flex justify-center">
    <ul role="list" class="mx-auto mt-10 grid max-w-2xl grid-cols-auto gap-x-8 gap-y-16 pt-10 sm:mt-16 sm:pt-16 lg:mx-1 lg:max-w-none lg:grid-cols-3 ">
    {allprojects.map((card: { slug: any; data: { image: { url: string; }; title: string; description: string; }; }) => <Card 
    url={`/projects/${card.slug}/`}  
    image={card.data.image.url} 
    title={card.data.title} 

/>)}
    </ul>
</div>
</Layout>


