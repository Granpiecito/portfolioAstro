---
import { getCollection } from "astro:content";
import ProjectsMarkdown from "../../../layouts/es/ProjectsMarkdown.astro";

export async function getStaticPaths() {
  const spanishProjects = await getCollection('projects', (project) => project.data.lang === 'es');

  return spanishProjects.map((spanishProjects) => ({
    params: { slug: spanishProjects.slug },
    props: { spanishProjects },
  }));
}

const { spanishProjects } = Astro.props;
const { Content } = await spanishProjects.render();
---

<ProjectsMarkdown frontmatter={spanishProjects.data}>
    <Content />
</ProjectsMarkdown>