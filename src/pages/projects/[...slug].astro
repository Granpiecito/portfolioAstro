---
import { getCollection } from "astro:content";
import ProjectsMarkdown from "../../layouts/ProjectsMarkdown.astro";

export async function getStaticPaths() {
  const englishProjects = await getCollection('projects', (project) => project.data.lang === 'en');

  return englishProjects.map((englishProjects) => ({
    params: { slug: englishProjects.slug },
    props: { englishProjects },
  }));
}

const { englishProjects } = Astro.props;
const { Content } = await englishProjects.render();
---

<ProjectsMarkdown frontmatter={englishProjects.data}>
    <Content />
</ProjectsMarkdown>