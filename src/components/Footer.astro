---
 const {pathname} = Astro.url;
 const year = new Date().getFullYear();
import {socials} from '../assets/js/data';
---
<footer class="grid grid-cols-none mt-28 scroll-m-36  xl:mt-flow-root sticky bottom">
    <div class="grid justify-center mt-28 scroll-m-36 md:justify-center sm:justify-center xl:justify-center">
        <ul class="justify-center flex flex-wrap xl:basis-[20%] md:basis-[28%] md:grid gap-4 grid-cols-2 sm:grid-cols-3 xs:grid-cols-2 md:justify-center"
            style="grid-template-columns: repeat({socials.length};"
        >
            {socials.map((social) => (
                <li>
                    <a 
                        href={social.url}
                        class="text-2xl opacity-50 hover:opacity-100 duration-300 ease-in cursor-pointer"
                    >
                        <i class={social.logo}></i>
                    </a>
                </li>
            ))}
        </ul> 
    </div>
    <div class="flex justify-center md:justify-center sm:justify-center xl:justify-center">
        <small class="text-center text-xs">
            &copy; {year} Portfolio-Astro by
            <a class="footer__link" href="https://github.com/Granpiecito"> JeanDev</a>.
            All Rights Reserved.
        </small>
    </div>
</footer>

