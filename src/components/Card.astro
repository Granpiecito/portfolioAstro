---
interface Props {
  url: string;
  image: string;
  title: string;
  body: string;
}

const { url, image, title, body } = Astro.props as Props;
---

<li class="center grid grid-cols-1">
    <a class="card_link" href={url}>
        <div class="card_img_container" >
            <img 
                class="card_image"
                width="220"
                height="110"
                src={image} 
                alt="Project Image"
            />
        </div>
        <h3 class="card_title">
            {title}
        </h3>
        <p class="card_txt">
            {body}
        </p>
    </a>
</li>