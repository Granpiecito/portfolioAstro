---
const { pathname } = Astro.url;

import { socials} from '../assets/js/data';
---

<nav class="w-full h-16 bg-black text-white flex items-center px-5 py-3 fixed top-0 z-50 md:justify-center
 xs:justify-center">
<ul class="grid justify-items-center gap-x-4 xl:basis-[30%] md:basis-[38%] sm:basis[50%] xs:basis[85%]"
style={ {gridTemplateColumns:`repeat(${pathname.split('/').length + 1 }, minmax(0, 1fr))`}}
>
        <li>
            <a class="opacity-70 hover:opacity-100 duration-300 text-[17px] font-semibold"
            href="/#Home">Home</a>
        </li>
        <li>
            <a class="opacity-70 hover:opacity-100 duration-300 text-[17px] font-semibold"
            href="/#about">About</a>
        </li>
        <li>
            <a class="opacity-70 hover:opacity-100 duration-300 text-[17px] font-semibold"
            href="/Projects">Projects</a>
        </li>
    </ul>
</nav>