---
const { pathname } = Astro.url;
---

<header
    class="header-animate backdrop-blur-[10px] md:backdrop-blur-0 w-full mb-10 overflow-visible z-[99999] py-6"
    data-astro-cid-4rde66u6=""
>
    <div
        class="grid items-center place-center md:justify-normal w-full grid-cols-[auto_0fr] mx-auto px-14 text-white gap-x-10 md:flex max-w-screen-full"
        data-astro-cid-4rde66u6=""
    >
        <div
            class="md:flex-grow md:basis-0 flex justify-start"
            data-astro-cid-4rde66u6=""
        >
            <a
                href="/"
                class="ml-4 flex items-center gap-2.5 font-bold transition-transform duration-300 hover:scale-110"
                title="Home Page"
                aria-label="Home Page"
            >
                /*un svg va aqui */
                <span class="hidden lg:block text-3xl font-montserrat"
                    >Jean</span
                >
                <span
                    class="text-[10px] opacity-80 uppercase font-semibold py-0.5 px-1.5 rounded-md bg-button border border-brand-blue block leading-none"
                >
                    Dev
                </span>
            </a>
        </div>
        <nav
            id="header-navbar"
            class="col-span-full overflow-x-auto row-[2/3] grid grid-rows-[0fr] transition-[grid-template-rows] data-[open]:grid-rows-[1fr] md:justify-center md:flex group/nav"
            data-astro-cid-4rde66u6=""
        >
            <ul
                data-header-navbar=""
                class="flex flex-col justify-center overflow-x-hidden overflow-y-hidden md:flex-row gap-x-3"
                data-astro-cid-4rde66u6=""
            >
                <li
                    class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
                    data-astro-cid-4rde66u6=""
                >
                    <a
                        href="/"
                        class="flex items-center md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                        data-astro-cid-4rde66u6=""
                    >
                        Home
                    </a>
                </li><li
                    class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
                    data-astro-cid-4rde66u6=""
                >
                    <a href="/#about" class="flex items-center md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                    data-astro-cid-4rde66u6="">
                        <span
                        >
                            About
                        </span>
                    </a>
                </li>
                <li
                    class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
                    data-astro-cid-4rde66u6=""
                >
                <a href="/Projects" class="flex items-center md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                data-astro-cid-4rde66u6="">
                <svg
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                data-astro-cid-4rde66u6=""
                            >
                                <g clip-path="url(#clip0_1_1261)">
                                    <path
                                        d="M15 12H15.01"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                    <path
                                        d="M12 12H12.01"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                    <path
                                        d="M9 12H9.01"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                    <path
                                        d="M6 19C5.46957 19 4.96086 18.7893 4.58579 18.4142C4.21071 18.0391 4 17.5304 4 17V13L3 12L4 11V7C4 6.46957 4.21071 5.96086 4.58579 5.58579C4.96086 5.21071 5.46957 5 6 5"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                    <path
                                        d="M18 19C18.5304 19 19.0391 18.7893 19.4142 18.4142C19.7893 18.0391 20 17.5304 20 17V13L21 12L20 11V7C20 6.46957 19.7893 5.96086 19.4142 5.58579C19.0391 5.21071 18.5304 5 18 5"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </g>
                                <defs>
                                    <clipPath id="clip0_1_1261">
                                        <rect
                                            width="24"
                                            height="24"
                                            fill="currentColor"></rect>
                                    </clipPath>
                                </defs>
                            </svg>
                        <span        
                        >
                            Projects
                        </span>
                    </a>
                </li>
            </ul>
        </nav>
        <button
            class="flex items-center justify-center py-2 md:hidden group"
            id="header-navbar-toggle"
            aria-controls="header-navbar"
            title="Mostrar Menú"
            aria-label="Mostrar menú"
            data-astro-cid-4rde66u6=""
        >
            <div
                class="flex items-center justify-center p-2 cursor-pointer"
                data-astro-cid-4rde66u6=""
            >
                <div class="space-y-2" data-astro-cid-4rde66u6="">
                    <span
                        class="block h-0.5 w-8 origin-center rounded-full bg-white/80 transition-transform ease-in-out group-aria-[expanded]:translate-y-[5px] group-aria-[expanded]:rotate-45"
                        data-astro-cid-4rde66u6=""></span>
                    <span
                        class="block h-0.5 w-8 origin-center rounded-full bg-white/80 transition-transform ease-in-out group-aria-[expanded]:-translate-y-[5px] group-aria-[expanded]:-rotate-45"
                        data-astro-cid-4rde66u6=""></span>
                </div>
            </div>
        </button>
    </div>
</header>
