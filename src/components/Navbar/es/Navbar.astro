---
const { pathname } = Astro.url;

import { generateLinks } from '../../../config/Generatelinks';

const currentSlug = '/es'; // Define dinámicamente según la página actual
const currentLang = Astro.params.lang || 'en'; // Si estás en "/", asume "en"

const links = generateLinks(currentLang);
---

<header
    class="header-animate  backdrop-blur-[10px] md:backdrop-blur-1 sm:backdrop-blur-1 w-full mb-10 overflow-visible z-[99999] py-4 rounded-b-lg shadow-lg shadow-blue-500/50"
    data-astro-cid-4rde66u6=""
>
    <div
        class="grid items-normal place-center md:justify-normal w-full grid-cols-[auto_0fr] mx-auto px-14 text-white gap-x-10 md:flex max-w-screen-full"
        data-astro-cid-4rde66u6=""
    >
        <div
            class="md:flex-grow md:basis-0 flex justify-start"
            data-astro-cid-4rde66u6=""
        >
            <a
                href="/es"
                class="ml-4 flex items-center gap-2.5 font-bold transition-transform duration-300 hover:scale-110"
                title="Home"
                aria-label="Home Page"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="30"
                    height="40"
                    viewBox="0 0 1711 2476.6"
                >
                    <defs>
                        <style>
                            .a {
                                fill: #0066b2;
                            }

                            .a,
                            .c {
                                stroke: #000;
                                stroke-miterlimit: 10;
                                stroke-width: 109px;
                            }

                            .b {
                                fill: #002d62;
                            }

                            .c {
                                fill: none;
                            }
                        </style>
                    </defs>
                    <g>
                        <path
                            class="a"
                            d="M2120.8,1212.8s59.5-748.1-635.6-706.4c0,0-535.2-41.7-535.2,639.5V2803.7a59.2,59.2,0,0,0,59.1,59.1l1112.9-4.1"
                            transform="translate(-895.5 -450.2)"></path>
                        <path
                            class="b"
                            d="M1438.5,2583.3c22.6,35.7,88.9,93.4,146.8,142.4,149.5,126.4,355.6,164.1,539.8,96.7,175.8-64.2,392.7-185.4,411.2-534.6,34.8-656.6-61.1-1773.6-61.1-1773.6L1710,477.8l10.3,65.9c320.5-56.3,462.9,379.8,447.5,671.3-.1,1.2-100.3-7.9-109.8-8-6.6-.1-643.5,2.3-650,2.5"
                            transform="translate(-895.5 -450.2)"></path>
                        <path
                            class="c"
                            d="M1714.4,514.2h761.2a44.9,44.9,0,0,1,44.9,44l31.4,1679.2q4.3,229.5-137,410.3c-85.8,110.3-219.6,224.6-423.5,224.6-458.8,0-614-214.3-614-702.1"
                            transform="translate(-895.5 -450.2)"></path>
                    </g>
                </svg>
                <span class="hidden lg:block text-3xl font-montserrat"
                    >JeanDev</span
                >
                <span
                    class="text-[10px] opacity-80 uppercase font-semibold py-0.5 px-1.5 rounded-md bg-button border border-brand-blue block leading-none"
                >
                    Developer
                </span>
            </a>
        </div>

        <nav
            id="header-navbar"
            class="col-span-full overflow-x-auto row-[2/3] grid grid-rows-[0fr] transition-[grid-template-rows] data-[open]:grid-rows-[1fr] md:justify-center md:flex group/nav"
            data-astro-cid-4rde66u6=""
        >
        <ul
        data-header-navbar=""
        class="flex flex-col justify-center overflow-x-hidden overflow-y-hidden md:flex-row gap-x-3"
        data-astro-cid-4rde66u6=""
    >
        <li
            class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
            data-astro-cid-4rde66u6=""
        >
            <a
                href="/es"
                class="flex items-center font-black md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                data-astro-cid-4rde66u6=""
            >
                Inicio
            </a>
        </li>
        <li
            class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
            data-astro-cid-4rde66u6=""
        >
            <a
                href="/#about"
                class="flex items-center font-black md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                data-astro-cid-4rde66u6=""
            >
                <span> Acerca de mi </span>
            </a>
        </li>
        <li
            class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
            data-astro-cid-4rde66u6=""
        >
        {links.map(link => (
            <a class="flex items-center font-black md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
            data-astro-cid-4rde66u6="" href={link.href + '/Proyectos'}>
                <span>
                        Proyectos
                </span>
            </a>
            ))}
        </li>
        <li
            class="flex justify-center w-full first:mt-5 md:first:mt-0 md:block md:w-auto"
            data-astro-cid-4rde66u6=""
        >
            <a
                href="/"
                class="flex items-center md:w-auto justify-center gap-2 md:px-4 md:py-2 hover:bg-brand-gray/5 md:rounded-2xl border border-transparent hover:border-brand-gray/10 transition-all min-h-[50px] md:text-base px-5 py-4 text-xl duration-300 w-full"
                data-astro-cid-4rde66u6=""
            >
                <span
                    ><svg
                        xmlns="http://www.w3.org/2000/svg"
                        height="24px"
                        viewBox="0 -960 960 960"
                        width="24px"
                        fill="#e8eaed"
                        ><path
                            d="M480-80q-82 0-155-31.5t-127.5-86Q143-252 111.5-325T80-480q0-83 31.5-155.5t86-127Q252-817 325-848.5T480-880q83 0 155.5 31.5t127 86q54.5 54.5 86 127T880-480q0 82-31.5 155t-86 127.5q-54.5 54.5-127 86T480-80Zm0-82q26-36 45-75t31-83H404q12 44 31 83t45 75Zm-104-16q-18-33-31.5-68.5T322-320H204q29 50 72.5 87t99.5 55Zm208 0q56-18 99.5-55t72.5-87H638q-9 38-22.5 73.5T584-178ZM170-400h136q-3-20-4.5-39.5T300-480q0-21 1.5-40.5T306-560H170q-5 20-7.5 39.5T160-480q0 21 2.5 40.5T170-400Zm216 0h188q3-20 4.5-39.5T580-480q0-21-1.5-40.5T574-560H386q-3 20-4.5 39.5T380-480q0 21 1.5 40.5T386-400Zm268 0h136q5-20 7.5-39.5T800-480q0-21-2.5-40.5T790-560H654q3 20 4.5 39.5T660-480q0 21-1.5 40.5T654-400Zm-16-240h118q-29-50-72.5-87T584-782q18 33 31.5 68.5T638-640Zm-234 0h152q-12-44-31-83t-45-75q-26 36-45 75t-31 83Zm-200 0h118q9-38 22.5-73.5T376-782q-56 18-99.5 55T204-640Z"
                        ></path></svg
                    >
                </span>
            </a>
        </li>
    </ul>
        </nav>
        <div class="md:hidden lg:hidden xl:hidden 2xl:hidden">
            <button
            class="flex items-center justify-center py-2 md:hidden group"
            id="header-navbar-toggle"
            aria-controls="header-navbar"
            title="Mostrar Menú"
            aria-label="Mostrar menú"
            aria-expanded="false" 
        >
            <div class="flex items-center justify-center p-2 cursor-pointer">
                <div class="space-y-2">
                    <span class="block h-0.5 w-8 origin-center rounded-full bg-white/80"></span>
                    <span class="block h-0.5 w-8 origin-center rounded-full bg-white/80"></span>
                </div>
            </div>
        </button>
          </div>
    </div>
</header>
